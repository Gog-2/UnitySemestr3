  CalculationsName: "\u041A\u0438\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u044D\u043D\u0435\u0440\u0433\u0438\u044F (0.5 * A * (B * B))"
  Formula: {fileID: 11400000, guid: 8f27b58dc94392b4abbaee4ba94aa3b6, type: 2}
  DiscriprionA: "\u041C\u0430\u0441\u0441\u0430 \u0442\u0435\u043B\u0430 (<i>m</i>),
    \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0432 \u043A\u0438\u043B\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0445
