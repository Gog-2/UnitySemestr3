  m_Script: {fileID: 11500000, guid: ab329b794722454e9160468a7d6095da, type: 3}
  m_Name: Period
  m_EditorClassIdentifier: Assembly-CSharp::Calculator.CalculatorSO
  CalculationsName: "\u041F\u0435\u0440\u0438\u043E\u0434 \u043F\u043E \u043E\u0440\u0431\u0438\u0442\u0435
    (2 * 3.14159 * A / B)"
  Formula: {fileID: 11400000, guid: cae7c2942b703482a9bab3384f5baf64, type: 2}
  DiscriprionA: "\u0420\u0430\u0434\u0438\u0443\u0441 \u043E\u0440\u0431\u0438\u0442\u044B/\u043E\u043A\u0440\u0443\u0436\u043D\u043E\u0441\u0442\u0438
    (<i>R</i>), \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0432
    \u043C\u0435\u0442\u0440\u0430\u0445 (\u043C)."
  DiscriprionB: "\u041B\u0438\u043D\u0435\u0439\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    (<i>v</i>), \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0432
    \u043C\u0435\u0442\u0440\u0430\u0445 \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
    (\u043C/\u0441)."
