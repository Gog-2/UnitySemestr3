  CalculationsName: "\u0421\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
    \u043C\u0435\u0434\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
    (0.017 * A / B)"
  Formula: {fileID: 11400000, guid: cb33957615358e8bdad5f17c938b6818, type: 2}
  DiscriprionA: "\u0414\u043B\u0438\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
    (<i>l</i>), \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0432
    \u043C\u0435\u0442\u0440\u0430\u0445 (\u043C)."
  DiscriprionB: "\u041F\u043B\u043E\u0449\u0430\u0434\u044C \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E\u0433\u043E
    \u0441\u0435\u0447\u0435\u043D\u0438\u044F (<i>S</i>), \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F
    \u0432 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0445 \u043C\u0438\u043B\u043B\u0438\u043C\u0435\u0442\u0440\u0430\u0445
    (\u043C\u043C<sup>2</sup>)."
