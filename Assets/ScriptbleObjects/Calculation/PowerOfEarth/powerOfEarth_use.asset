  CalculationsName: "\u0421\u0438\u043B\u0430 \u0442\u044F\u0436\u0435\u0441\u0442\u0438
    \u043D\u0430 \u0417\u0435\u043C\u043B\u0435 (9.81 * A * B)"
  Formula: {fileID: 11400000, guid: 838a8b7a8dd6de5f5a9107fa0cd2ec82, type: 2}
  DiscriprionA: "</b> \u041C\u0430\u0441\u0441\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0442\u0435\u043B\u0430 (<i>m</i>), \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F
    \u0432 \u043A\u0438\u043B\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0445 (\u043A\u0433)."
  DiscriprionB: "</b> \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0442\u0435\u043B (<i>N</i>) \u0438\u043B\u0438 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u044B\u0439
    \u043C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C (\u0443\u043A\u0430\u0436\u0438\u0442\u0435
    1 \u0434\u043B\u044F \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u043E\u0433\u043E
    \u0442\u0435\u043B\u0430)."
